  <vhdl appearance="logisim_evolution" name="dff_ms">LIBRARY ieee;
USE ieee.std_logic_1164.ALL;

ENTITY dff_ms IS
    PORT (
        clk   : IN  std_logic;
        d     : IN  std_logic;
        set   : IN  std_logic;
        clr   : IN  std_logic;
        q     : OUT std_logic;
        q_not : OUT std_logic
    );
END dff_ms;

ARCHITECTURE behavior OF dff_ms IS
    SIGNAL q_int : std_logic := '0';
BEGIN
    PROCESS(clk, clr, set)
    BEGIN
        IF clr = '1' THEN
            q_int &lt;= '0';
        ELSIF set = '1' THEN
            q_int &lt;= '1';
        ELSIF rising_edge(clk) THEN
            q_int &lt;= d;
        END IF;
    END PROCESS;

    q     &lt;= q_int;
    q_not &lt;= NOT q_int;
END behavior;</vhdl>
